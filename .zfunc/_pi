#compdef pi
# zsh completion for pi (AI coding assistant)
# Generated against pi 1.4.0 — re-check `pi --help` after `pi update`.
#
# Install: file must be named `_pi` in a directory on your $fpath
# (e.g. ~/.zfunc/_pi with `fpath=(~/.zfunc $fpath)` before `compinit`).
# Then: `rm -f ~/.zcompdump && exec zsh`
#
# Conventions (per project instructions): no variable abbreviations.
# Well-established initialisms (ID, URL, API) are permitted.

