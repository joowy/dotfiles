#!/usr/bin/env bash
# mise task: reposync — one round trip for the git-backed working repositories.
#
# Run it when you sit down at a machine and again when you leave it. Per
# repository it shows the diff, asks, then commits, rebases onto the remote,
# and pushes.
#
#   reposync              show the diff, then ask before each repository
#   reposync --yes        the same round trip with no questions, for scripts
#   reposync status       report state, change nothing
#   reposync --dry-run    print the plan, change nothing
#   reposync --help       this text
#
# `status`, `--yes`, and `--dry-run` work on every repository at once and print
# each report in list order when the whole batch finishes. The interactive run
# stays one repository at a time, because the questions need the terminal.
#
# Override the repository list with a colon-separated REPOSYNC_REPOSITORIES,
# and the machine label in commit messages with REPOSYNC_MACHINE_NAME.
set -euo pipefail

readonly DEFAULT_REPOSITORIES="$HOME/repos/Obsidian:$HOME/repos/LeetCode:$HOME/repos/leetcode-visualization"

readonly EXIT_OK=0
readonly EXIT_FAILED=1
readonly EXIT_SKIPPED=2
readonly EXIT_QUIT=3

failures=0
skipped=0
dry_run=0
assume_yes=0
report_only=0

# Prints the leading comment block, so the usage text has no line count to
# drift out of step.
show_help() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

for argument in "$@"; do
  case "$argument" in
  status)
    report_only=1
    ;;
  --yes | -y)
    assume_yes=1
    ;;
  --dry-run | -n)
    dry_run=1
    ;;
  --help | -h)
    show_help
    exit 0
    ;;
  *)
    printf 'unknown argument: %s\n' "$argument" >&2
    printf 'try: reposync --help\n' >&2
    exit 2
    ;;
  esac
done

if [ "$report_only" -eq 0 ] && [ "$assume_yes" -eq 0 ] && [ "$dry_run" -eq 0 ] &&
  [ ! -t 0 ]; then
  printf 'reposync asks before each commit and there is no terminal here;\n' >&2
  printf 'use `reposync --yes`, `reposync status`, or `reposync --dry-run`\n' >&2
  exit 2
fi

machine_name() {
  if [ -n "${REPOSYNC_MACHINE_NAME:-}" ]; then
    printf '%s' "$REPOSYNC_MACHINE_NAME"
    return
  fi
  local battery_path
  for battery_path in /sys/class/power_supply/BAT*; do
    if [ -e "$battery_path" ]; then
      printf 'laptop'
      return
    fi
  done
  printf 'desktop'
}

readonly commit_message="reposync from $(machine_name) $(date '+%Y-%m-%d %H:%M')"

is_git_repository() {
  git -C "$1" rev-parse --git-dir >/dev/null 2>&1
}

upstream_of() {
  git -C "$1" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true
}

commits_between() {
  git -C "$1" rev-list --count "$2" 2>/dev/null || printf '0'
}

change_count_of() {
  git -C "$1" status --porcelain | wc -l
}

show_changes() {
  local directory="$1"
  local upstream="$2"

  git -C "$directory" --no-pager status --short

  if [ -n "$upstream" ]; then
    local outgoing
    outgoing="$(commits_between "$directory" "$upstream..HEAD")"
    if [ "$outgoing" -gt 0 ]; then
      printf '    push these commits:\n'
      git -C "$directory" --no-pager log --oneline --decorate=short "$upstream..HEAD" |
        sed 's/^/      /'
    fi
  fi
}

show_diff() {
  local directory="$1"

  # delta reads the diff on stdin and renders it side by side with line
  # numbers, matching the renderer lazygit uses so both tools look the same.
  # It pages through less only when the output is longer than the screen, so
  # short diffs print inline. Quitting that pager early sends SIGPIPE to git,
  # which must not abort the run.
  if command -v delta >/dev/null 2>&1; then
    git -C "$directory" diff |
      delta --navigate --side-by-side --line-numbers || true
  else
    git -C "$directory" --no-pager diff || true
  fi

  git -C "$directory" ls-files --others --exclude-standard | sed 's/^/  untracked: /'
}

# Asks whether to touch this repository. Returns EXIT_OK to proceed, and
# EXIT_SKIPPED or EXIT_QUIT to leave it alone.
review_gate() {
  local directory="$1"
  local change_count="$2"
  local incoming="$3"
  local outgoing="$4"
  local upstream="$5"
  local upcoming
  local answer

  if [ -z "$upstream" ]; then
    upcoming="not published yet"
  else
    upcoming="$incoming to pull, $outgoing to push"
  fi

  printf '    uncommitted %s, %s\n' "$change_count" "$upcoming"
  show_changes "$directory" "$upstream"
  if [ "$change_count" -gt 0 ]; then
    show_diff "$directory"
  fi

  while true; do
    printf '    [d]iff again  [y]es, sync it  [n]o, skip it  [q]uit > '
    IFS= read -r answer || return "$EXIT_QUIT"
    case "$answer" in
    d | D)
      show_diff "$directory"
      ;;
    y | Y)
      return "$EXIT_OK"
      ;;
    n | N | "")
      return "$EXIT_SKIPPED"
      ;;
    q | Q)
      return "$EXIT_QUIT"
      ;;
    *)
      printf '    pick d, y, n, or q\n'
      ;;
    esac
  done
}

commit_pending() {
  local directory="$1"
  local change_count="$2"

  if [ "$change_count" -eq 0 ]; then
    printf '    nothing to commit\n'
    return 0
  fi

  git -C "$directory" add --all
  git -C "$directory" commit --quiet --message "$commit_message"
  printf '    committed %s change(s)\n' "$change_count"
}

pull_remote() {
  local directory="$1"
  local upstream="$2"
  local incoming

  incoming="$(commits_between "$directory" "HEAD..$upstream")"
  if [ "$incoming" -eq 0 ]; then
    return 0
  fi

  if ! git -C "$directory" pull --quiet --rebase --autostash; then
    git -C "$directory" rebase --abort >/dev/null 2>&1 || true
    printf '    pull failed, fix the conflict by hand in %s\n' "$directory" >&2
    return "$EXIT_FAILED"
  fi
  printf '    pulled %s commit(s)\n' "$incoming"
}

push_remote() {
  local directory="$1"
  local branch="$2"
  local upstream="$3"
  local outgoing

  if [ -z "$upstream" ]; then
    if ! git -C "$directory" push --quiet --set-upstream origin "$branch"; then
      printf '    publish failed, check the remote and your credentials\n' >&2
      return "$EXIT_FAILED"
    fi
    printf '    published %s to origin\n' "$branch"
    return 0
  fi

  outgoing="$(commits_between "$directory" "$upstream..HEAD")"
  if [ "$outgoing" -eq 0 ]; then
    printf '    remote up to date\n'
    return 0
  fi

  if ! git -C "$directory" push --quiet; then
    printf '    push failed, work is committed locally\n' >&2
    return "$EXIT_FAILED"
  fi
  printf '    pushed %s commit(s)\n' "$outgoing"
}

sync_repository() {
  local directory="$1"
  local name
  name="$(basename "$directory")"

  printf '\n==> %s\n' "$name"

  if [ ! -d "$directory" ]; then
    printf '    missing, skipping\n'
    return "$EXIT_SKIPPED"
  fi

  # The pi privacy barrier mounts the vault read-only and hides its .git. Say so
  # plainly instead of failing halfway through a commit.
  if [ ! -w "$directory" ]; then
    printf '    read-only here (pi privacy barrier), run this in a normal terminal\n' >&2
    return "$EXIT_SKIPPED"
  fi

  if ! is_git_repository "$directory"; then
    printf '    no git repository, skipping\n' >&2
    return "$EXIT_FAILED"
  fi

  local branch
  branch="$(git -C "$directory" symbolic-ref --quiet --short HEAD || true)"
  if [ -z "$branch" ]; then
    printf '    detached HEAD, skipping\n' >&2
    return "$EXIT_FAILED"
  fi

  local change_count
  change_count="$(change_count_of "$directory")"

  local upstream
  upstream="$(upstream_of "$directory")"

  if [ "$dry_run" -eq 0 ] && [ -n "$upstream" ]; then
    if ! git -C "$directory" fetch --quiet origin; then
      printf '    fetch failed, check the network and your credentials\n' >&2
      return "$EXIT_FAILED"
    fi
  fi

  local incoming outgoing
  incoming="$(commits_between "$directory" "HEAD..$upstream")"
  outgoing="$(commits_between "$directory" "$upstream..HEAD")"

  if [ -n "$upstream" ] && [ "$change_count" -eq 0 ] &&
    [ "$incoming" -eq 0 ] && [ "$outgoing" -eq 0 ]; then
    printf '    up to date\n'
    return "$EXIT_OK"
  fi

  if [ "$dry_run" -eq 1 ]; then
    if [ "$change_count" -gt 0 ]; then
      printf '    would commit %s change(s)\n' "$change_count"
    else
      printf '    nothing to commit\n'
    fi
    if [ -z "$upstream" ]; then
      printf '    would publish %s to origin\n' "$branch"
      return "$EXIT_OK"
    fi
    if [ "$incoming" -gt 0 ]; then
      printf '    would pull %s commit(s)\n' "$incoming"
    fi
    if [ "$outgoing" -gt 0 ]; then
      printf '    would push %s commit(s)\n' "$outgoing"
    else
      printf '    remote up to date\n'
    fi
    return "$EXIT_OK"
  fi

  if [ "$assume_yes" -eq 0 ]; then
    local gate_status=0
    review_gate "$directory" "$change_count" "$incoming" "$outgoing" "$upstream" ||
      gate_status=$?
    case "$gate_status" in
    0) ;;
    "$EXIT_QUIT") return "$EXIT_QUIT" ;;
    *) return "$EXIT_SKIPPED" ;;
    esac
  fi

  commit_pending "$directory" "$change_count" || return "$EXIT_FAILED"

  if [ -n "$upstream" ]; then
    pull_remote "$directory" "$upstream" || return "$EXIT_FAILED"
  fi

  push_remote "$directory" "$branch" "$upstream" || return "$EXIT_FAILED"

  return "$EXIT_OK"
}

status_repository() {
  local directory="$1"
  local name
  name="$(basename "$directory")"
  printf '%-26s' "$name"

  if [ ! -d "$directory" ]; then
    printf 'missing\n'
    return "$EXIT_SKIPPED"
  fi

  if [ ! -w "$directory" ]; then
    printf 'read-only here (pi privacy barrier), check it in a normal terminal\n'
    return "$EXIT_SKIPPED"
  fi

  if ! is_git_repository "$directory"; then
    printf 'no git repository\n'
    return "$EXIT_FAILED"
  fi

  local branch
  branch="$(git -C "$directory" symbolic-ref --quiet --short HEAD || printf 'detached')"

  local change_count
  change_count="$(change_count_of "$directory")"

  local upstream
  upstream="$(upstream_of "$directory")"

  if [ -z "$upstream" ]; then
    printf '%s, uncommitted %s, not published\n' "$branch" "$change_count"
    return "$EXIT_OK"
  fi

  git -C "$directory" fetch --quiet origin >/dev/null 2>&1 || true

  local incoming outgoing
  incoming="$(commits_between "$directory" "HEAD..$upstream")"
  outgoing="$(commits_between "$directory" "$upstream..HEAD")"

  printf '%s, uncommitted %s, behind %s, ahead %s\n' \
    "$branch" "$change_count" "$incoming" "$outgoing"

  return "$EXIT_OK"
}

# Tallies one repository's exit code for the closing summary.
record_result() {
  case "$1" in
  "$EXIT_OK") ;;
  "$EXIT_SKIPPED") skipped=$((skipped + 1)) ;;
  *) failures=$((failures + 1)) ;;
  esac
}

# Runs one step for every repository at the same time. Each repository writes
# into its own files, so the reports cannot interleave, and the batch replays
# them in list order once the slowest repository finishes. Only for runs that
# never read from the terminal: two repositories cannot share one prompt.
run_all_in_parallel() {
  local operation="$1"
  shift

  local batch_directory
  batch_directory="$(mktemp -d "${TMPDIR:-/tmp}/reposync.XXXXXX")"
  trap "rm -rf '$batch_directory'" EXIT

  local repository
  local position=0
  local process_id
  local exit_code
  local status_file
  local -a batch_repositories=("$@")
  local -a batch_process_ids=()

  for repository in "${batch_repositories[@]}"; do
    position=$((position + 1))
    (
      set +e
      "$operation" "$repository"
      printf '%s\n' "$?" >"$batch_directory/$position.status"
    ) >"$batch_directory/$position.output" 2>"$batch_directory/$position.error" &
    batch_process_ids+=("$!")
  done

  for process_id in "${batch_process_ids[@]}"; do
    wait "$process_id" || true
  done

  position=0
  for repository in "${batch_repositories[@]}"; do
    position=$((position + 1))
    if [ -s "$batch_directory/$position.output" ]; then
      cat "$batch_directory/$position.output"
    fi
    if [ -s "$batch_directory/$position.error" ]; then
      cat "$batch_directory/$position.error" >&2
    fi

    status_file="$batch_directory/$position.status"
    exit_code="$EXIT_FAILED"
    if [ -s "$status_file" ]; then
      read -r exit_code <"$status_file"
    fi

    if [ "$exit_code" -eq "$EXIT_QUIT" ]; then
      printf '\nstopped at your request\n'
      exit 0
    fi
    record_result "$exit_code"
  done
}

IFS=':' read -r -a repositories <<<"${REPOSYNC_REPOSITORIES:-$DEFAULT_REPOSITORIES}"

# One cleaned list, so every path below sees the same repositories.
active_repositories=()
for repository in "${repositories[@]}"; do
  if [ -n "$repository" ]; then
    active_repositories+=("$repository")
  fi
done

if [ "$report_only" -eq 1 ]; then
  run_all_in_parallel status_repository "${active_repositories[@]}"
elif [ "$assume_yes" -eq 1 ] || [ "$dry_run" -eq 1 ]; then
  run_all_in_parallel sync_repository "${active_repositories[@]}"
else
  for repository in "${active_repositories[@]}"; do
    exit_code="$EXIT_OK"
    sync_repository "$repository" || exit_code=$?
    if [ "$exit_code" -eq "$EXIT_QUIT" ]; then
      printf '\nstopped at your request\n'
      exit 0
    fi
    record_result "$exit_code"
  done
fi

if [ "$failures" -gt 0 ]; then
  printf '\n%s repository/repositories need attention\n' "$failures" >&2
  exit 1
fi

if [ "$skipped" -gt 0 ]; then
  printf '\n%s repository/repositories left alone\n' "$skipped"
  exit 0
fi

printf '\nall repositories synced\n'
