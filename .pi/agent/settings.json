{
  "lastChangelogVersion": "0.84.2",
  "enableInstallTelemetry": false,
  "theme": "light/dark",
  "packages": [
    "npm:pi-web-access",
    "git:github.com/obra/superpowers",
    "npm:@ogulcancelik/pi-herdr",
