{
  "lastChangelogVersion": "1.5.2",
  "enableInstallTelemetry": false,
  "theme": "light/dark",
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-footer",
    "npm:pi-context-view",
    "npm:pi-subagents-lite",
    "npm:pi-slash-suggest",
    "npm:@gotgenes/pi-permission-system",
    "npm:@narumitw/pi-usage",
    "npm:@cortexkit/pi-anthropic-auth@2.10.0"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "defaultThinkingLevel": "high",
  "skills": [
    "~/.claude/skills",
    "~/.codex/skills",
    "../.claude/skills"
  ],
  "newLine": [
    "shift+enter",
    "ctrl+j"
  ],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-5-5",
  "enabledModels": [
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-haiku-5-5",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/gemini-4-argon",
    "llama.cpp/*",
    "anthropic/claude-opus-5-5"
  ],
  "showHardwareCursor": true,
  "showCacheMissNotices": true,
  "quietStartup": false,
  "treeFilterMode": "user-only",
  "tuiMode": "regular",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-footer\",\"scope\":\"user\"}": "0.5.1",
    "{\"source\":\"npm:@gotgenes/pi-permission-system\",\"scope\":\"user\"}": "42.0.0",
    "{\"source\":\"npm:pi-context-view\",\"scope\":\"user\"}": "0.8.4",
    "{\"source\":\"npm:@narumitw/pi-usage\",\"scope\":\"user\"}": "0.69.3"
  },
  "hideThinkingBlock": true
}