{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "~/.agents": "allow",
      "~/repos/": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*personal*": "deny"
    },
    "bash": {
      "rm *": "ask",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git commit *": "ask",
      "* commit *": "ask",
      "git push": "deny",
      "* push *": "deny"
    },
    "external_directory": "ask"
  }
}
