#!/usr/bin/env bash
#
# pi-docker — run pi in Docker (Colima) with the workspace mounted.
#
# Usage: pi-docker [--] [pi args...]
#   -h, --help                            show this help (pi's own help: pi-docker -- --help)
#   --rebuild [dockerfile] [--no-extensions]   rebuild pi-sandbox (clean) + update extensions, then exit
#
# Runs:
#   HERDR_AGENT=pi docker run --rm -it \
#     -v "$PWD:/workspace" \
#     -v "pi-agent-home:/root/.pi/agent" \
#     [-v "$OBSIDIAN_ROOT:/vault" + tmpfs masks, when the vault is involved] \
#     pi-sandbox [pi args...]
#
# Fixed vault topology: when the host workspace involves the Obsidian vault
# (inside it, or a project with a nested vault checkout such as
# .worktrees/obsidian), the canonical vault is also mounted at /vault and the
# private folder is masked with tmpfs (fail closed). The agent reads vault
# notes via /vault, never via a nested duplicate.
#
# Rebuilds from (override with $PI_SANDBOX_DOCKERFILE or an arg):
#   ~/repos/docker-images/Dockerfile.pi
#
# Colima is auto-started if the Docker daemon is not responding.

set -euo pipefail

IMAGE="pi-sandbox"
VOLUME="pi-agent-home"
WORKDIR="/workspace"
COLIMA_TIMEOUT=90
DEFAULT_DOCKERFILE="$HOME/repos/docker-images/Dockerfile.pi"
DOCKERFILE="${PI_SANDBOX_DOCKERFILE:-$DEFAULT_DOCKERFILE}"

usage() {
    echo "usage: $(basename "$0") [--] [pi args...]" >&2
    echo "       $(basename "$0") --rebuild [dockerfile] [--no-extensions]" >&2
    echo "" >&2
    echo "Run pi in Docker (image: $IMAGE, Colima auto-start)." >&2
    echo "All args are passed through to pi inside the container." >&2
    echo "  pi-docker                  launch interactive pi in \$PWD" >&2
    echo "  pi-docker -p 'fix bug'      non-interactive prompt" >&2
    echo "  pi-docker -- --help         show pi's help (not this help)" >&2
    echo "  pi-docker --rebuild         rebuild $IMAGE (clean) + update extensions, then exit" >&2
    echo "    (rebuild also syncs the permission config into $VOLUME)" >&2
    echo "" >&2
    echo "Vault topology (fixed container paths):" >&2
    echo "  /workspace == \$PWD (unchanged)" >&2
    echo "  /vault     == canonical vault (\$OBSIDIAN_ROOT, default ~/repos/Obsidian)" >&2
    echo "Masks (tmpfs, fail closed): /vault/<private folder>, the nested" >&2
    echo ".worktrees/obsidian duplicate, and /workspace/<private folder> when" >&2
    echo "launching from the vault root itself." >&2
    echo "Env: OBSIDIAN_ROOT selects the vault checkout; PI_MOUNT_VAULT=1 forces /vault." >&2
}

# --- Parse arguments (wrapper takes no flags except help/rebuild) ------------

rebuild=false
rebuild_target=""
skip_extensions=false
case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
    --rebuild)
        rebuild=true
        # Optional: --rebuild [dockerfile] [--no-extensions] (either order).
        for arg in "${2:-}" "${3:-}"; do
            case "$arg" in
                --no-extensions) skip_extensions=true ;;
                --) ;;
                "") ;;
                *) rebuild_target="$arg" ;;
            esac
        done
        ;;
esac

# Allow explicit separator so pi flags can't be mistaken for wrapper flags.
if [ "${1:-}" = "--" ]; then
    shift
fi

# --- Check dependencies ------------------------------------------------------

for tool in docker colima; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "error: '$tool' not found on PATH" >&2
        exit 1
    }
done

# --- Ensure Docker daemon (auto-start Colima) --------------------------------

ensure_daemon() {
    if docker info >/dev/null 2>&1; then
        return 0
    fi
    echo "docker daemon not responding, starting colima..." >&2
    colima start >&2

    local elapsed=0
    while ! docker info >/dev/null 2>&1; do
        if [ "$elapsed" -ge "$COLIMA_TIMEOUT" ]; then
            echo "error: docker daemon still not responding after ${COLIMA_TIMEOUT}s (colima start failed?)" >&2
            return 1
        fi
        sleep 2
        elapsed=$((elapsed + 2))
    done
}

# --- Rebuild (clean image + extensions in persistent volume) -------------------

if $rebuild; then
    if [ -n "$rebuild_target" ]; then
        DOCKERFILE="$rebuild_target"
    fi
    # Allow a directory: prefer Dockerfile.pi, fall back to Dockerfile.
    if [ -d "$DOCKERFILE" ]; then
        if [ -f "$DOCKERFILE/Dockerfile.pi" ]; then
            DOCKERFILE="$DOCKERFILE/Dockerfile.pi"
        else
            DOCKERFILE="$DOCKERFILE/Dockerfile"
        fi
    fi
    if [ ! -f "$DOCKERFILE" ]; then
        echo "error: Dockerfile not found: $DOCKERFILE" >&2
        echo "hint: pass the path explicitly: $(basename "$0") --rebuild ~/repos/docker-images/Dockerfile.pi" >&2
        echo "hint: or set PI_SANDBOX_DOCKERFILE" >&2
        exit 1
    fi
    ensure_daemon
    context="$(dirname "$DOCKERFILE")"
    echo "rebuilding $IMAGE from $DOCKERFILE (context: $context)..." >&2
    docker build --pull --no-cache -f "$DOCKERFILE" -t "$IMAGE" "$context"
    echo "rebuilt $IMAGE:" >&2
    docker image inspect "$IMAGE" --format 'created={{.Created}} id={{.Id}}' >&2
    if ! $skip_extensions; then
        if ! docker volume inspect "$VOLUME" >/dev/null 2>&1; then
            docker volume create "$VOLUME" >/dev/null
        fi
        # Extensions live in $VOLUME (/root/.pi/agent), so this persists.
        # Same entrypoint assumption as normal runs: image runs pi.
        echo "updating pi extensions in $VOLUME..." >&2
        HERDR_AGENT=pi docker run --rm \
            -v "$VOLUME:/root/.pi/agent" \
            "$IMAGE" update --extensions
    fi
    # Sync the permission policy (source of truth: this repo) into the
    # persistent volume, so container-path denies stay effective in the volume
    # that shadows the baked image config at /root/.pi/agent.
    dotfiles_root="$(cd "$(dirname "$0")/.." && pwd)"
    permission_source="$dotfiles_root/.pi/agent/extensions/pi-permission-system/config.json"
    echo "syncing permission config into $VOLUME..." >&2
    docker run --rm --entrypoint /bin/sh \
        -v "$VOLUME:/root/.pi/agent" \
        -v "$permission_source:/tmp/fresh-permission-config.json:ro" \
        "$IMAGE" -c 'mkdir -p /root/.pi/agent/extensions/pi-permission-system && cp /tmp/fresh-permission-config.json /root/.pi/agent/extensions/pi-permission-system/config.json'
    exit 0
fi

# --- Ensure persistent volume + image ----------------------------------------

if ! docker volume inspect "$VOLUME" >/dev/null 2>&1; then
    docker volume create "$VOLUME" >/dev/null
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "error: docker image '$IMAGE' not found locally" >&2
    echo "hint: docker images | grep $IMAGE" >&2
    exit 1
fi

# --- TTY handling (-it only when interactive) ---------------------------------

# Always keep -i so stdin reaches pi; add -t only on a TTY so
# piped/non-interactive use (e.g. echo ... | pi-docker -p ...) still works.
tty_flags=(-i)
if [ -t 0 ] && [ -t 1 ]; then
    tty_flags=(-it)
fi

# --- Fixed vault topology (Option A) -----------------------------------------

# Canonical vault checkout on the host. Overridable for testing or moves.
OBSIDIAN_ROOT="${OBSIDIAN_ROOT:-$HOME/repos/Obsidian}"
# Leaf name of the private folder inside the vault. Single source of truth for
# every mask destination below; permission rules name the same leaf.
PRIVATE_LEAF="01-personal"
# Nested vault checkout, relative to the workspace root (myproject convention).
NESTED_VAULT_PATH=".worktrees/obsidian"

find_enclosing_vault_root() {
    local search_dir="$PWD"
    while true; do
        if [ -d "$search_dir/.obsidian" ] && [ -d "$search_dir/$PRIVATE_LEAF" ]; then
            printf '%s' "$search_dir"
            return 0
        fi
        if [ "$search_dir" = "/" ]; then
            return 1
        fi
        search_dir="$(dirname "$search_dir")"
    done
}

# A nested vault checkout is present when it carries the vault marker.
nested_vault_present=false
if [ -d "$PWD/$NESTED_VAULT_PATH/.obsidian" ]; then
    nested_vault_present=true
fi

# The workspace itself may sit inside the vault (vault root or a subdir).
enclosing_vault_root="$(find_enclosing_vault_root || true)"

# Decide the canonical vault source. Prefer the enclosing checkout when the
# workspace sits inside the vault; otherwise use OBSIDIAN_ROOT, which must
# exist when a nested vault (or an explicit opt-in) asks for /vault.
vault_mount_source=""
if [ -n "$enclosing_vault_root" ]; then
    vault_mount_source="$enclosing_vault_root"
elif [ "$nested_vault_present" = true ] || [ "${PI_MOUNT_VAULT:-}" = "1" ]; then
    if [ ! -d "$OBSIDIAN_ROOT/.obsidian" ]; then
        echo "error: vault requested but canonical vault is missing: $OBSIDIAN_ROOT" >&2
        echo "hint: set OBSIDIAN_ROOT to the vault checkout" >&2
        exit 1
    fi
    vault_mount_source="$OBSIDIAN_ROOT"
fi

# Extra Docker args for the vault topology. Empty when the vault is not
# involved: other repos see zero behavior change.
vault_docker_args=()
if [ -n "$vault_mount_source" ]; then
    # Fail closed: never expose the vault without its private-folder mask.
    if [ ! -d "$vault_mount_source/$PRIVATE_LEAF" ]; then
        echo "error: expected private folder is missing: $vault_mount_source/$PRIVATE_LEAF" >&2
        echo "hint: refusing to launch with an unmasked vault (fail closed)" >&2
        exit 1
    fi
    vault_docker_args+=(-v "$vault_mount_source:/vault")
    vault_docker_args+=(--mount "type=tmpfs,destination=/vault/$PRIVATE_LEAF")
    # Nested duplicate: hide the whole checkout so /vault stays the single
    # canonical spelling the agent is allowed to read.
    if [ "$nested_vault_present" = true ]; then
        vault_docker_args+=(--mount "type=tmpfs,destination=/workspace/$NESTED_VAULT_PATH")
    fi
    # Launched from the vault root itself: the same bytes are also visible via
    # /workspace, so mask that spelling too. (From a vault subdir the private
    # folder sits outside $PWD, so only the /vault mask applies.)
    if [ -d "$PWD/.obsidian" ] && [ -d "$PWD/$PRIVATE_LEAF" ]; then
        vault_docker_args+=(--mount "type=tmpfs,destination=/workspace/$PRIVATE_LEAF")
    fi
fi

# --- Run ---------------------------------------------------------------------

# Quoted "$PWD" is safe for paths with spaces.
# Two branches: "${vault_docker_args[@]}" must never expand empty under
# `set -u` on older bash (macOS ships bash 3.2).
if [ "${#vault_docker_args[@]}" -gt 0 ]; then
    HERDR_AGENT=pi exec docker run --rm "${tty_flags[@]}" \
        -v "$PWD:$WORKDIR" \
        -v "$VOLUME:/root/.pi/agent" \
        "${vault_docker_args[@]}" \
        -w "$WORKDIR" \
        "$IMAGE" "$@"
else
    HERDR_AGENT=pi exec docker run --rm "${tty_flags[@]}" \
        -v "$PWD:$WORKDIR" \
        -v "$VOLUME:/root/.pi/agent" \
        -w "$WORKDIR" \
        "$IMAGE" "$@"
fi
