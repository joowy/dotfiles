#!/usr/bin/env zsh
# ABOUTME: Creates or attaches to a git worktree, prompting via fzf/vared for
# ABOUTME: any of --repo/--branch/--path not given explicitly.
#
# Prints the resolved worktree path as the LAST line of stdout. All picker
# UI, progress output, and messages go to stderr/tty so stdout stays clean
# for the shell function in ~/dotfiles/.zshrc that cd's into the result:
#
#   wt() { local d; d=$(command wt "$@") && cd -- "$d"; }

emulate -L zsh
setopt pipefail
bindkey -e

usage() {
  cat <<'EOF'
Usage: wt [--repo PATH] [--branch NAME] [--path PATH]

Create or attach to a git worktree, prompting via fzf for any argument not
given explicitly. Prints the resolved worktree path on stdout; wrap with a
shell function to cd into it (see ~/dotfiles/.zshrc).

  --repo PATH       Path to the target repository (default: fzf picker over ~/repos)
  --branch NAME     Branch to check out or create (default: fzf picker + type-to-create)
  --path PATH       Worktree directory (default: <repo>/.worktrees/<branch-slug>, editable)
EOF
}

slugify() {
  local s="${1}"
  s="${s//[^a-z0-9]/-}"
  while [[ "$s" == *--* ]]; do s="${s//--/-}"; done
  s="${s#-}"
  s="${s%-}"
  [[ -z "$s" ]] && s="worktree"
  print -r -- "$s"
}

default_branch_of() {
  local repo="$1" base candidate
  if [[ -n "$(git -C "$repo" remote 2>/dev/null)" ]]; then
    base=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
    base="${base#origin/}"
    if [[ -z "$base" ]]; then
      for candidate in main master; do
        if git -C "$repo" rev-parse --verify "origin/$candidate" >/dev/null 2>&1; then
          base="$candidate"
          break
        fi
      done
    fi
  fi
  if [[ -z "$base" ]]; then
    for candidate in main master; do
      if git -C "$repo" rev-parse --verify "$candidate" >/dev/null 2>&1; then
        base="$candidate"
        break
      fi
    done
  fi
  print -r -- "$base"
}

repo=""
branch=""
wt_path=""

while [[ $# -gt 0 ]]; do
  case "$1" in
  --repo)
    repo="$2"
    shift 2
    ;;
  --branch)
    branch="$2"
    shift 2
    ;;
  --path)
    wt_path="$2"
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "wt: unknown argument: $1" >&2
    usage >&2
    exit 1
    ;;
  esac
done

if ! command -v fzf >/dev/null 2>&1; then
  echo "wt: fzf is required" >&2
  exit 1
fi

# --- resolve repo ---
if [[ -z "$repo" ]]; then
  repo_list=$(find ~/repos -maxdepth 1 -mindepth 1 -type d 2>/dev/null | while read -r d; do
    [[ -e "$d/.git" ]] && print -r -- "$d"
  done | sort)
  if [[ -z "$repo_list" ]]; then
    echo "wt: no git repos found under ~/repos" >&2
    exit 1
  fi
  repo=$(print -r -- "$repo_list" | fzf --prompt="repo ")
  [[ -z "$repo" ]] && {
    echo "wt: no repo selected" >&2
    exit 1
  }
fi
repo=$(cd "${repo}/" 2>/dev/null && pwd) || {
  echo "wt: repo not found: $repo" >&2
  exit 1
}
if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "wt: not a git repository: $repo" >&2
  exit 1
fi

# --- resolve branch ---
if [[ -z "$branch" ]]; then
  output=$(git -C "$repo" branch --format='%(refname:short)' | fzf --prompt="branch " --print-query)
  fzf_status=$?
  if [[ $fzf_status -eq 130 ]]; then
    echo "wt: aborted" >&2
    exit 1
  fi
  query=$(print -r -- "$output" | sed -n '1p')
  selection=$(print -r -- "$output" | sed -n '2p')
  branch="${selection:-$query}"
fi
[[ -z "$branch" ]] && {
  echo "wt: no branch given" >&2
  exit 1
}

# --- resolve path ---
if [[ -z "$wt_path" ]]; then
  slug=$(slugify "$branch")
  wt_path="$repo/.worktrees/$slug"
  vared -p "path> " wt_path </dev/tty >/dev/tty
fi
wt_path="${wt_path#}"
case "$wt_path" in
/*) ;;
*) wt_path="$PWD/$wt_path" ;;
esac
wt_path="${wt_path%/}"
[[ -z "$wt_path" ]] && {
  echo "wt: no path given" >&2
  exit 1
}

# --- act ---
already_worktree=$(git -C "$repo" worktree list --porcelain | awk -v p="$wt_path" '
/^worktree / { wt = substr($0, 10) }
wt == p { found = 1 }
END { if (found) print "yes" }
')

if [[ "$already_worktree" == "yes" ]]; then
  echo "wt: $wt_path is already a worktree, attaching" >&2
elif git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
  git -C "$repo" worktree add "$wt_path" "$branch" 1>&2 || exit $?
else
  base=$(default_branch_of "$repo")
  if [[ -z "$base" ]]; then
    echo "wt: could not determine default branch for $repo" >&2
    exit 1
  fi
  if ! git -C "$repo" fetch origin "$base" >/dev/null 2>&1; then
    echo "wt: warning: failed to fetch origin/$base, branching from local state" >&2
  fi
  base_ref="origin/$base"
  git -C "$repo" rev-parse --verify "$base_ref" >/dev/null 2>&1 || base_ref="$base"
  git -C "$repo" worktree add --no-track -b "$branch" "$wt_path" "$base_ref" 1>&2 || exit $?
fi

print -r -- "$wt_path"
