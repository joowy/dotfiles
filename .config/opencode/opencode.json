{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "llama.cpp": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama-server (local)",
            "options": {
                "baseURL": "http://127.0.0.1:8001/v1"
            },
            "models": {
                "Qwen3.5": {
                    "name": "Qwen3.5",
                    "limit": {
                        "context": 200000,
                        "output": 200000
                    }
                }
            }
        }
    },
    "permission": {
        "webfetch": "allow",
        "question": "allow",
        "edit": "allow",
        "read": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "glob": "allow",
        "bash": {
            "ls *": "allow",
            "git *": "allow",
            "npm *": "allow",
            "grep *": "allow",
            "rm *": "ask",
            "sudo *": "deny",
            "* --version": "allow",
            "* --help *": "allow",
            "git commit *": "ask",
            "git push": "deny"
        }
    }
}